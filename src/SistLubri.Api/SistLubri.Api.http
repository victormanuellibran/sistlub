@host = http://localhost:5033

GET {{host}}/api/health
Accept: application/json

###

# Reemplace estas credenciales por el administrador creado mediante /api/auth/bootstrap.
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "contrasena": "Reemplazar-Por-La-Clave-Real"
}

###

@token = {{login.response.body.$.token}}

POST {{host}}/api/clientes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Ana",
  "apellido": "Gomez",
  "telefono": "351 555-0101",
  "email": "ana@example.com",
  "domicilio": "Alvear 123",
  "observaciones": null
}

###

GET {{host}}/api/clientes?buscar=Ana
Accept: application/json
Authorization: Bearer {{token}}

###

# @name crearProducto
POST {{host}}/api/productos
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo": "ACE-10W40-4L",
  "nombre": "Aceite 10W40",
  "marca": "Ejemplo",
  "categoria": "Aceites",
  "presentacion": "Bidon 4 L",
  "unidadMedida": "Unidad",
  "precioVenta": 35000,
  "costoCompra": 25000,
  "esFraccionado": false,
  "stockInicial": 10,
  "stockMinimo": 3
}

###

@productoId = {{crearProducto.response.body.$.id}}

POST {{host}}/api/productos/{{productoId}}/movimientos
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "tipo": "Salida",
  "cantidad": 2,
  "motivo": "Prueba de salida manual",
  "referenciaId": null
}

###

GET {{host}}/api/productos/{{productoId}}/movimientos
Accept: application/json
Authorization: Bearer {{token}}

###

GET {{host}}/api/productos/alertas
Accept: application/json
Authorization: Bearer {{token}}

###

# Servicio: iniciar la orden reserva stock sin descontarlo del stock fisico.
# Reemplace la patente y el productoId por registros existentes en la base local.
# @name crearServicio
POST {{host}}/api/servicios
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "patente": "AB123CD",
  "kilometrajeIngreso": 50000,
  "trabajoSolicitado": "Cambio de aceite y filtro",
  "inspeccionPrevia": "Sin novedades visibles",
  "danosExistentes": null,
  "observaciones": null,
  "manoObra": 12000,
  "detalles": [
    {
      "productoId": "00000000-0000-0000-0000-000000000001",
      "cantidad": 4
    }
  ]
}

###

@servicioId = {{crearServicio.response.body.$.id}}

GET {{host}}/api/servicios/{{servicioId}}
Accept: application/json
Authorization: Bearer {{token}}

###

GET {{host}}/api/servicios/en-curso
Accept: application/json
Authorization: Bearer {{token}}

###

PUT {{host}}/api/servicios/{{servicioId}}/detalles
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "trabajoSolicitado": "Cambio de aceite y filtro",
  "observaciones": "Se revisaron los niveles",
  "manoObra": 12000,
  "detalles": [
    {
      "productoId": "00000000-0000-0000-0000-000000000001",
      "cantidad": 4
    }
  ]
}

###

POST {{host}}/api/servicios/{{servicioId}}/finalizar
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "kilometrajeFinal": 50000,
  "proximoCambioKilometraje": 60000,
  "productosUtilizados": [
    {
      "productoId": "00000000-0000-0000-0000-000000000001",
      "cantidadUtilizada": 3
    }
  ]
}

###

POST {{host}}/api/servicios/{{servicioId}}/anular
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "motivo": "El cliente cancelo el trabajo",
  "productosUtilizados": [
    {
      "productoId": "00000000-0000-0000-0000-000000000001",
      "cantidadUtilizada": 1
    }
  ]
}

###

GET {{host}}/api/servicios/patente/AB123CD
Accept: application/json
Authorization: Bearer {{token}}

###
